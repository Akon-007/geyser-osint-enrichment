OSINT_API_KEY=replace-with-a-long-random-server-to-server-key
OSINT_HOST=127.0.0.1
OSINT_PORT=8081
OSINT_LOG_LEVEL=INFO
OSINT_MAX_LEADS=20
OSINT_MAX_RESULTS=200
OSINT_TOOL_TIMEOUT_SECONDS=30
OSINT_MAX_CONCURRENCY=3
OSINT_RETRY_ATTEMPTS=2
OSINT_FAILURE_COOLDOWN_SECONDS=30
OSINT_ENABLE_BLACKBIRD=false
OSINT_BLACKBIRD_COMMAND=python vendor/blackbird/blackbird.py
OSINT_ENABLE_SOCIAL_ANALYZER=false
OSINT_SOCIAL_ANALYZER_COMMAND=python vendor/social-analyzer/app.py
OSINT_ENABLE_SPIDERFOOT=false
OSINT_SPIDERFOOT_COMMAND=python vendor/spiderfoot/sfcli.py

